module 'IGA' Input
author 'José García Yeste'
version 1 2
tags sensor co2 tvoc
description 'Support for Sensirion IGA Air Quality Sensor.
Returns the CO2 in ppm and TVOC in ppb.

Based on: https://github.com/adafruit/Adafruit_IGA/blob/master/Adafruit_IGA.cpp'

variables '_IGA inizialized' 

	spec 'r' 'IGA connected' 'IGA connected'
	spec 'r' 'IGA read' 'IGA read air quality'
	spec 'r' 'IGA read raw' 'IGA read raw'
	spec ' ' 'IGA setup' 'IGA setup'
	spec 'r' 'IGA get baseline' 'IGA get baseline'
	spec ' ' 'IGA set baseline' 'IGA set baseline co2 _ tvoc _' 'auto auto' 36885 36209
	spec 'r' '_IGA generate CRC' '_IGA generate CRC _' 'auto' 400

to 'IGA connected' {
  local 'cmd' ('[data:makeList]' (hexToInt '20') (hexToInt '2F'))
  local 'response' (newList 3)
  '[sensors:i2cWrite]' (hexToInt '58') cmd
  waitMillis 10
  '[sensors:i2cRead]' (hexToInt '58') response
  local 'featureset' (((at 1 response) << 8) | (at 2 response))
  return ((featureset & (hexToInt 'F0')) == (hexToInt '20'))
}

to 'IGA read' {
  'IGA setup'
  local 'cmd' ('[data:makeList]' (hexToInt '20') (hexToInt '08'))
  local 'response' (newList 6)
  '[sensors:i2cWrite]' (hexToInt '58') cmd
  waitMillis 12
  local 'aq' (newList 2)
  '[sensors:i2cRead]' (hexToInt '58') response
  atPut 1 aq (((at 1 response) << 8) | (at 2 response))
  atPut 2 aq (((at 4 response) << 8) | (at 5 response))
  return aq
}

to 'IGA setup' {
  if ((v '_IGA inizialized') == 0) {
    '_IGA inizialized' = 1
    local 'cmd' ('[data:makeList]' (hexToInt '20') (hexToInt '03'))
    '[sensors:i2cWrite]' (hexToInt '58') cmd
    waitMillis 10
  }
}

to 'IGA read raw' {
  'IGA setup'
  local 'cmd' ('[data:makeList]' (hexToInt '20') (hexToInt '50'))
  local 'response' (newList 6)
  '[sensors:i2cWrite]' (hexToInt '58') cmd
  waitMillis 25
  local 'raw' (newList 2)
  '[sensors:i2cRead]' (hexToInt '58') response
  atPut 1 raw (((at 1 response) << 8) | (at 2 response))
  atPut 2 raw (((at 4 response) << 8) | (at 5 response))
  return raw
}


to 'IGA get baseline' {
  'IGA setup'
  local 'cmd' ('[data:makeList]' (hexToInt '20') (hexToInt '15'))
  local 'response' (newList 6)
  '[sensors:i2cWrite]' (hexToInt '58') cmd
  waitMillis 10
  local 'baseline' (newList 2)
  '[sensors:i2cRead]' (hexToInt '58') response
  atPut 1 baseline (((at 1 response) << 8) | (at 2 response))
  atPut 2 baseline (((at 4 response) << 8) | (at 5 response))
  return baseline
}

to 'IGA set baseline' co2 tvoc {
  'IGA setup'
  local 'cmd' ('[data:makeList]' (hexToInt '20') (hexToInt '1E') (tvoc >> 8) (tvoc & 255) ('_IGA generate CRC' tvoc) (co2 >> 8) (co2 & 255) ('_IGA generate CRC' co2))
  '[sensors:i2cWrite]' (hexToInt '58') cmd
  waitMillis 10
}

to '_IGA generate CRC' value {
  local 'buf' ('[data:makeList]' (value >> 8) (value & 255))
  local 'crc' (hexToInt 'FF')
  for i (size buf) {
    crc = (crc ^ (at i buf))
    for i 8 {
      if ((crc & (hexToInt '80')) != 0) {
        crc = ((crc << 1) ^ (hexToInt '31'))
      } else {
        crc = (crc << 1)
      }
    }
  }
  return (crc & 255)
}

script 642 50 {
to 'IGA set baseline' {}
}



