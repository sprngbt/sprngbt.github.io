
module 'IWB' Input
author 'José García Yeste'
version 1 0 
description 'SPL06-001 Air pressure sensor
Tested on Springbot Demo Kit
Base on https://github.com/ArtronShop/ArtronShop_SPL06-001/
'
variables _IWB_addr _IWB_coefs _IWB_scaleFactor _IWB_baseAltitude _IWB_basePressure 

  spec 'r' 'IWB connected' 'IWB connected'
  spec 'r' 'IWB air pressure' 'IWB air pressure (mBar)'
  spec 'r' 'IWB temperature (°C)' 'IWB temperature (°C)'
  space
  spec 'r' 'IWB altitude' 'IWB altitude (cm)'
  spec ' ' 'IWB set current altitude' 'IWB set current altitude _ meters' 'num' 0
  space
  spec ' ' '_IWB init' '_IWB init'
  spec ' ' '_IWB read coefficients' '_IWB read coefficients'
  spec 'r' '_IWB_altitudeMillimeters' '_IWB_altitudeMillimeters'
  spec 'r' '_IWB_rawPressure' '_IWB_rawPressure'
  spec 'r' '_IWB get24bits' '_IWB get24bits _' 'num' 0

to '_IWB get24bits' reg {
  local 'buf' (newList 3)
  '[sensors:i2cWrite]' _IWB_addr reg
  '[sensors:i2cRead]' _IWB_addr buf
  local 'res' ((((at 1 buf) << 16) | ((at 2 buf) << 8)) | (at 3 buf))
  if (res > (1 << 23)) {
    res = (res - (1 << 24))
  }
  return res
}

to '_IWB init' {
  if (_IWB_addr != 0) {return}
  _IWB_addr = 119
  comment 'RESET'
  i2cSet _IWB_addr (hexToInt 'C') 9
  waitMillis 50
  comment ' MODE_BACKGND_BOTH'
  i2cSet _IWB_addr 8 7
  local 'IWB_scaleFactors' ('[data:makeList]' 524288 1572864 3670016 7864320 253952 516096 1040384 2088960)
  comment 'Oversampling 0-7 (5 = 32x)'
  local 'IWB_oversampling' 5
  _IWB_scaleFactor = (at (IWB_oversampling + 1) IWB_scaleFactors)
  i2cSet _IWB_addr 6 ((hexToInt '60') | (IWB_oversampling & 7))
  i2cSet _IWB_addr 7 ((hexToInt 'B0') | (IWB_oversampling & 7))
  i2cSet _IWB_addr 9 (ifExpression (IWB_oversampling >= 4) (hexToInt 'C') 8)
  waitMillis 100
  '_IWB read coefficients'
}

to '_IWB read coefficients' {
  local 'buf' (newList 18)
  _IWB_coefs = (newList 9)
  '[sensors:i2cWrite]' _IWB_addr (hexToInt '10')
  '[sensors:i2cRead]' _IWB_addr buf
  comment 'c0'
  atPut 1 _IWB_coefs (((at 1 buf) << 4) | ((at 2 buf) >> 4))
  if ((at 1 _IWB_coefs) > (1 << 11)) {
    atPut 1 _IWB_coefs ((at 1 _IWB_coefs) - (1 << 12))
  }
  comment 'c1'
  atPut 2 _IWB_coefs ((((at 2 buf) & (hexToInt 'F')) << 8) | (at 3 buf))
  if ((at 2 _IWB_coefs) > (1 << 11)) {
    atPut 2 _IWB_coefs ((at 2 _IWB_coefs) - (1 << 12))
  }
  comment 'c01, c11, c20, c21, c30'
  for c ('[data:range]' 3 7) {
    local 'coef' (((at ((c * 2) + 3) buf) << 8) | (at ((c * 2) + 4) buf))
    if (coef > (1 << 15)) {
      coef = (coef - (1 << 16))
    }
    atPut c _IWB_coefs coef
  }
  comment 'c00, c10'
  atPut 8 _IWB_coefs ((((at 4 buf) << 12) | ((at 5 buf) << 4)) | ((at 6 buf) >> 4))
  if ((at 8 _IWB_coefs) > (1 << 19)) {
    atPut 8 _IWB_coefs ((at 8 _IWB_coefs) - (1 << 20))
  }
  atPut 9 _IWB_coefs (((((at 6 buf) & (hexToInt 'F')) << 16) | ((at 7 buf) << 8)) | (at 8 buf))
  if ((at 9 _IWB_coefs) > (1 << 19)) {
    atPut 9 _IWB_coefs ((at 9 _IWB_coefs) - (1 << 20))
  }
}

to '_IWB_altitudeMillimeters' {
  if (_IWB_basePressure == 0) {
    comment 'if base altitude not set, use zero (useful for relative measurments)'
    'IWB set current altitude' 0
  }
  return ('[misc:pressureToAltitude]' ('_IWB_rawPressure') _IWB_basePressure)
}

to '_IWB_rawPressure' {
  '_IWB init'
  local 'praw' ('_IWB get24bits' 0)
  local 'traw' ('_IWB get24bits' 3)
  local 'k' (_IWB_scaleFactor >> 10)
  local 'f1' ((longMult praw ((at 9 _IWB_coefs) + ((longMult praw ((at 5 _IWB_coefs) + ((longMult praw (at 7 _IWB_coefs) 10) / k)) 10) / k)) 10) / k)
  local 'f3' ((longMult traw ((longMult praw ((at 4 _IWB_coefs) + ((longMult praw (at 6 _IWB_coefs) 10) / k)) 10) / k) 10) / k)
  return (sum (at 8 _IWB_coefs) f1 ((longMult traw (at 3 _IWB_coefs) 10) / k) f3)
}

to 'IWB air pressure' {
  return ((('_IWB_rawPressure') + 50) / 100)
}

to 'IWB altitude' {
  return ((('_IWB_altitudeMillimeters') + 5) / -10)
}

to 'IWB connected' {
  '_IWB init'
  return (((i2cGet _IWB_addr (hexToInt 'D')) & (hexToInt 'F0')) == 16)
}

to 'IWB set current altitude' baseMeters {
  '_IWB init'
  local 'total' 0
  repeat 20 {
    total += ('_IWB_rawPressure')
    waitMillis 1
  }
  _IWB_basePressure = (total / 20)
  _IWB_baseAltitude = baseMeters
}

to 'IWB temperature (°C)' {
  '_IWB init'
  local 'traw' ('_IWB get24bits' 3)
  return (((at 1 _IWB_coefs) / 2) + ((traw * (at 2 _IWB_coefs)) / _IWB_scaleFactor))
}

