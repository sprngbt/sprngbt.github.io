module main
author unknown
version 1 0 
description ''
variables json file 

  spec 'r' 'json Structure' 'json Structure _' 'auto' 'list of jsons'
  spec 'r' 'json' 'json _ _' 'auto auto' 'key' 'value or json Structure'
  spec 'r' 'pretty' 'pretty _' 'auto' 'json Structure'
  spec 'r' 'str' 'str _' 'auto' 'string'
  spec ' ' 'output to OLED' 'output to OLED _' 'auto' '10'
  spec ' ' 'output to file' 'output to file _' 'auto' 10
  spec ' ' 'output to screen' 'output to screen _' 'auto' '10'
  spec ' ' 'show all JSONs' 'show all JSONs _' 'auto' '10'

to 'output to OLED' JSON {
  '[tft:clear]'
  tft_drawText (pretty JSON) 1 0 false 1
  tft_drawText '>B' 100 50 false 2
}

to 'output to file' JSON {
  '[file:open]' file
  '[file:appendLine]' 'Next JSON:' file
  '[file:appendLine]' ' ' file
  '[file:appendLine]' JSON file
  '[file:appendLine]' ' ' file
  '[file:appendLine]' 'Same JSON prettified:' file
  '[file:appendLine]' ' ' file
  '[file:appendLine]' (pretty JSON) file
  '[file:appendLine]' ' ' file
  '[file:appendLine]' 'End of this JSON' file
  '[file:appendLine]' ' ' file
  '[file:close]' file
}

to 'output to screen' JSON {
  sayIt JSON ('[data:unicodeString]' 10) ('[data:unicodeString]' 10) 'Prettified:' ('[data:unicodeString]' 10) (pretty JSON)
}

to 'show all JSONs' JSON {
  'output to screen' JSON
  'output to OLED' JSON
  'output to file' JSON
  comment 'Next?'
  waitUntil (buttonB)
  comment 'Debounce...'
  waitMillis 500
}

script 1121 50 {
to 'output to file' {}
}

script 62 53 {
whenStarted
file = 'JSON.txt'
'[file:delete]' file
comment 'JSON with just one key/value pair passed as a string'
'show all JSONs' ('json Structure' (json 'temp [ºC]' ('[sensors:temperature]')))
comment 'JSON with just several key/value pairs passed as a list'
'show all JSONs' ('json Structure' ('[data:makeList]' (json 'light level' ('[display:lightLevel]')) (json 'animal' 'dog') (json 'standing' ((absoluteValue ('[sensors:tiltY]')) > 80))))
comment 'Nested JSON with just several key/value pairs passed as a list'
'show all JSONs' ('json Structure' ('[data:makeList]' (json 'CWS' ('json Structure' ('[data:makeList]' (json 'light level' ('[display:lightLevel]')) (json 'animal' 'dog')))) (json 'IWA' ('json Structure' ('[data:makeList]' (json 'light level' ('[display:lightLevel]')) (json 'standing' ((absoluteValue ('[sensors:tiltY]')) > 80)))))))
}

script 682 53 {
to 'show all JSONs' {}
}

script 682 53 {
to 'show all JSONs' {}
}

